<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#17202b">
<title>GAME-S</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    font-family: Arial, sans-serif;
    color: white;
    background:
        linear-gradient(rgba(10,15,25,.25), rgba(10,15,25,.45)),
        url("/static/images/background.png") center center / cover fixed;
    padding: 25px 18px 110px;
}

header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 35px;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 2px;
}

.logo span {
    color: #ffb5d8;
}

.glass {
    background: rgba(255,255,255,.13);
    border: 1px solid rgba(255,255,255,.28);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    box-shadow: 0 8px 30px rgba(0,0,0,.12),
                inset 0 1px 1px rgba(255,255,255,.2);
}

.menu {
    width: 46px;
    height: 46px;
    border-radius: 17px;
    display: grid;
    place-items: center;
    font-size: 22px;
}

.welcome {
    margin: 35px 0 25px;
}

.welcome h1 {
    font-size: 30px;
    margin-bottom: 10px;
}

.welcome p {
    color: rgba(255,255,255,.85);
    line-height: 1.6;
    font-size: 14px;
}

.section-title {
    font-size: 18px;
    margin: 25px 0 14px;
}

.card {
    padding: 20px;
    border-radius: 24px;
    margin-bottom: 15px;
}

.card h3 {
    font-size: 17px;
    margin-bottom: 10px;
}

.card p {
    font-size: 14px;
    line-height: 1.7;
    color: rgba(255,255,255,.85);
}

.bottom-nav {
    position: fixed;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    width: calc(100% - 36px);
    max-width: 430px;
    padding: 10px;
    border-radius: 25px;
    display: flex;
    justify-content: space-around;
    gap: 8px;
}

.nav-btn {
    flex: 1;
    border: 1px solid rgba(255,255,255,.48);
    background: rgba(255,255,255,.16);
    color: white;
    border-radius: 18px;
    padding: 13px 5px;
    font-size: 12px;
    cursor: pointer;
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
        inset 0 1px 2px rgba(255,255,255,.45),
        0 4px 12px rgba(0,0,0,.12);
    transition: .25s ease;
}

.nav-btn.active {
    background: rgba(255,180,215,.34);
    border: 1px solid rgba(255,225,240,.8);
    box-shadow:
        inset 0 1px 3px rgba(255,255,255,.5),
        0 0 18px rgba(255,160,205,.25);
}

footer {
    text-align: center;
    margin-top: 35px;
    color: rgba(255,255,255,.7);
    font-size: 12px;
    letter-spacing: 1px;
}
</style>
</head>

<body>

<header>
    <div class="logo">GAME<span>-S</span></div>
   
</header>

<main>
    <section class="welcome">
        <h1>Welcome to GAME-S</h1>
        <p>Your gaming space. Discover tools, settings and useful features.</p>
    </section>

    <h2 class="section-title">Instructions</h2>

    <div class="card glass">
        <h3>🎮 Getting Started</h3>
        <p>Explore the available tools and discover useful features for your gaming experience.</p>
    </div>

    <div class="card glass">
        <h3>✨ Latest Updates</h3>
        <p>Stay informed about new features and improvements.</p>
    </div>

    <footer>Created with passion by SLMA</footer>
</main>

<nav class="bottom-nav glass">
    <button class="nav-btn">⚙️<br>Settings</button>
    <button class="nav-btn">🎮<br>Tools</button>
    <button class="nav-btn active">⌂<br>Home</button>
</nav>

</body>
</html>

